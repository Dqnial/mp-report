# Скопировать в deploy/.env и заполнить. .env в git не попадает.

# адрес приложения без https:// — например vizity.duckdns.org
DOMAIN=

POSTGRES_USER=mp
# длинный случайный: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=mp_report

# секрет подписи токенов входа: openssl rand -hex 32
JWT_ACCESS_SECRET=

# резервные копии: куда копировать вне сервера (rclone), например r2:mp-report-backups
# пусто — копии только на самом сервере (не рекомендуется)
BACKUP_REMOTE=
