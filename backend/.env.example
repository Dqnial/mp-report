DATABASE_URL=postgresql://mp:mp@localhost:5434/mp_report
PORT=3000
JWT_ACCESS_SECRET=change-me-access
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=90
# в продакшене true (HTTPS); локально false, чтобы куки работали по http
COOKIE_SECURE=false

# адрес фронта — из него собираются ссылки-приглашения
APP_URL=http://localhost:5173
INVITE_TTL_DAYS=7

# Redis (docker compose в корне): очереди, лимит входа, кеш отчёта.
# Пусто — работаем без Redis: импорт шаблона сразу, лимит в памяти, без кеша.
REDIS_URL=redis://localhost:6380
# документация API на /api/docs (в проде по умолчанию выключена)
SWAGGER=true
