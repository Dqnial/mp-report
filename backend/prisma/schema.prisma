generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  login        String   @unique
  passwordHash String
  fullName     String
  isAdmin      Boolean  @default(false)
  createdAt    DateTime @default(now())

  sessions       Session[]
  invitesCreated Invite[]   @relation("InviteCreatedBy")
  invitesUsed    Invite[]   @relation("InviteUsedBy")
  templates      Template[]
  places         Place[]
  contacts       Contact[]
  visits         Visit[]

  @@map("users")
}

model Session {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  refreshHash String   @unique
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// одноразовое приглашение на регистрацию; ссылку админ шлёт коллеге
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  /// sha256 от токена из ссылки — сам токен не храним
  tokenHash   String    @unique
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  usedById    String?   @unique @db.Uuid
  createdAt   DateTime  @default(now())

  createdBy User  @relation("InviteCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy    User? @relation("InviteUsedBy", fields: [usedById], references: [id], onDelete: SetNull)

  @@map("invites")
}

model Template {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  /// "2026-10"
  month        String
  originalName String
  /// оригинал файла руководителя, никогда не меняется
  file         Bytes
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("templates")
}

enum PlaceKind {
  CLINIC
  PHARMACY
}

model Place {
  id      String    @id @default(uuid()) @db.Uuid
  userId  String    @db.Uuid
  kind    PlaceKind
  name    String
  address String?

  /// аптека: последняя договорённость (с аптекой, а не с провизором — они меняются)
  lastAgreement     String?
  lastAgreementDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@index([userId, kind])
  @@map("places")
}

model Contact {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  placeId   String? @db.Uuid
  fullName  String
  specialty String?
  phone     String?

  /// последняя договорённость с врачом — подставляется в следующий визит
  lastAgreement     String?
  /// дата визита, на котором о ней договорились (правка старого визита не затрёт новую)
  lastAgreementDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  place  Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)
  visits Visit[]

  @@index([userId])
  @@map("contacts")
}

enum VisitKind {
  DOCTOR
  PHARMACY
}

model Visit {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  /// генерится на телефоне — дедупликация офлайн-синка
  clientId  String    @unique
  date      DateTime  @db.Date
  kind      VisitKind
  contactId String?   @db.Uuid

  // снимок полей строки отчёта на момент визита
  placeName String?
  address   String?
  fullName  String?
  specialty String?
  phone     String?

  /// [{ code, stock? }], до 4 (у импортированных из файла — сколько распознали)
  products Json    @default("[]")
  comment  String?

  // договорённость (переносится на следующий визит: у врача — к этому врачу,
  // у аптеки — в эту аптеку), факт выполнения, отклонение. В отчёт — в N.
  agreement String?
  fact      String?
  deviation String?

  /// Визит «из файла»: номер строки в шаблоне месяца, где он уже записан.
  /// Такие визиты экспорт пропускает (они уже в файле), в приложении — только
  /// просмотр; при повторной загрузке шаблона перечитываются заново.
  templateRow Int?
  /// J–M как было написано в файле — распознавание препаратов нечёткое
  productsRaw String?

  /// Офлайн-синк. Время последней правки НА УСТРОЙСТВЕ: из двух правок одного
  /// визита с разных телефонов побеждает более поздняя.
  clientUpdatedAt DateTime?
  /// Мягкое удаление (время удаления на устройстве): запись остаётся, чтобы
  /// старая правка с другого телефона не «воскресила» визит; можно восстановить.
  deletedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@map("visits")
}
